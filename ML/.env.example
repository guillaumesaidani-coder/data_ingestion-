# Copier en .env (non commité) pour `docker run --env-file .env` ou le
# développement local. Valeurs par défaut : voir indusense/config.py —
# le service tourne sans .env, avec les mêmes valeurs de dev qu'ici.

API_KEY=dev-local-key
MODEL_PATH=/app/artifacts/models/model.joblib

DB_USER=indusense_user
DB_PASSWORD=ThEP@ssW0rd
DB_HOST=localhost
DB_PORT=5432
DB_NAME=indusense_db

# Stack unique (R1) : prédictions et verdicts techniciens dans le Postgres de la
# stack (localhost:5432), comme l API conteneurisée. Sans cette ligne, Streamlit
# et les flows lancés sur le PC écrivent dans artifacts/predictions.db (SQLite).
PREDICTIONS_DB_URL=postgresql+psycopg2://indusense_user:ThEP%40ssW0rd@localhost:5432/indusense_db
