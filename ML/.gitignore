# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets locaux (clé API, mot de passe DB) — jamais commités
.env

# macOS
.DS_Store

# Données brutes (contiennent des données personnelles non anonymisées)
releves_incidents.csv

# Fichiers générés
# `?*` et non `*` : `artifacts/*` matche aussi le dossier lui-même pour
# DVC (scmrepo), qui sautait alors artifacts/models/model.joblib.dvc lors
# d'un `dvc push` global. `?*` exige au moins un caractère -> même effet
# pour Git, sans ce faux positif.
artifacts/?*
# ... sauf la model card — c'est un livrable de documentation, pas un artefact jetable
!artifacts/model_card.md
# ... et artifacts/models/ : metrics.json/params.yaml (petits, versionnés par Git) +
# model.joblib.dvc (pointeur DVC) — le .joblib lui-même reste ignoré, DVC s'en charge.
!artifacts/models/
artifacts/models/?*
!artifacts/models/metrics.json
!artifacts/models/params.yaml
!artifacts/models/*.dvc
/telemetry.csv
/releves_incidents_anonymised.csv

# Gold exporté par le flow (module 29/30) — régénéré depuis Postgres, pas une source
/data/gold/*.csv

# Dumps de fenêtres de dérive (module 31-34) — régénérés par scripts/drift_windows.py,
# plusieurs Mo chacun ; seuls les résultats (spec, suivi, PSI par feature) sont versionnés.
/reports/drift/reference_*.csv
/reports/drift/window_*.csv

# Base MLflow locale (binaire, change à chaque run) : ne pas versionner dans Git
mlflow_tp7.db
